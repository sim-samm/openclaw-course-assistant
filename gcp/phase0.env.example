# Copy to phase0.env in this directory (gitignored) and set real values.
#   cp phase0.env.example phase0.env
#
# shellcheck disable=SC2034
export GCP_PROJECT_ID="your-gcp-project-id"
export GCE_ZONE="us-central1-a"
export GCE_VM_NAME="openclaw-gateway"
export GCE_MACHINE_TYPE="e2-small"
export GCE_BOOT_DISK_GB="20"
export GCE_IMAGE_FAMILY="debian-12"
export GCE_IMAGE_PROJECT="debian-cloud"

# Local laptop port forwarded to the gateway Control UI on the VM (OpenClaw default 18789).
export LOCAL_TUNNEL_PORT="18789"
export GCE_GATEWAY_PORT="18789"

# Set true if your org requires Identity-Aware Proxy for SSH.
export GCE_USE_IAP_TUNNEL="false"
